* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf
*.png binary
*.jpg binary
*.pk4 binary
*.pk3 binary
*.wasm binary

# Patches against CRLF sources must keep their CRs byte-for-byte, or git apply fails
targets/*/patches/*.patch binary
targets/*/patches/*.manifest.txt -text
