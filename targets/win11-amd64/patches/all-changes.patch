+*/
+void Sym_GetFuncInfo( address_t addr, idStr &module, idStr &funcName ) {
+	module = "";
+	sprintf( funcName, "0x%016llx", (unsigned long long)addr );	// x64: address is 64-bit
+}
+
+#endif
+
+/*
+==================
+GetFuncAddr
+==================
+*/
+#if !defined(_M_X64)	/* x64: prologue signature scan and ebp chain walk are x86-only */
+
+address_t GetFuncAddr( address_t midPtPtr ) {
+	long temp;
+	do {
+		temp = (long)(*(long*)midPtPtr);
+		if ( (temp&0x00FFFFFF) == PROLOGUE_SIGNATURE ) {
+			break;
+		}
+		midPtPtr--;
+	} while(true);
+
+	return midPtPtr;
+}
+
+/*
+==================
+GetCallerAddr
+==================
+*/
+address_t GetCallerAddr( long _ebp ) {
+	long midPtPtr;
+	long res = 0;
+
+	__asm {
+		mov		eax, _ebp
+		mov		ecx, [eax]		// check for end of stack frames list
+		test	ecx, ecx		// check for zero stack frame
+		jz		label
+		mov		eax, [eax+4]	// get the ret address
+		test	eax, eax		// check for zero return address
+		jz		label
+		mov		midPtPtr, eax
+	}
+	res = GetFuncAddr( midPtPtr );
+label:
+	return res;
+}
+
+#endif	/* !_M_X64 */
+
+/*
+==================
+Sys_GetCallStack
+
+  use /Oy option
+==================
+*/
+void Sys_GetCallStack( address_t *callStack, const int callStackSize ) {
+#if defined(_M_X64)
+	// x64: the ebp chain does not exist, ask the OS unwinder (uses the .pdata unwind tables).
+	// Skip this function so frame 0 is the caller.
+	void *frames[64];
+	int i, n;
+
+	n = callStackSize < 64 ? callStackSize : 64;
+	n = (int)CaptureStackBackTrace( 1, (DWORD)n, frames, NULL );
+	for ( i = 0; i < n; i++ ) {
+		callStack[i] = (address_t)frames[i];
+	}
+	for ( ; i < callStackSize; i++ ) {
+		callStack[i] = 0;
+	}
+#else
+	int i;
+	long m_ebp;
+
+	__asm {
+		mov eax, ebp
+		mov m_ebp, eax
+	}
+	// skip last two functions
+	m_ebp = *((long*)m_ebp);
+	m_ebp = *((long*)m_ebp);
+	// list functions
+	for ( i = 0; i < callStackSize; i++ ) {
+		callStack[i] = GetCallerAddr( m_ebp );
+		if ( callStack[i] == 0 ) {
+			break;
+		}
+		m_ebp = *((long*)m_ebp);
+	}
+	while( i < callStackSize ) {
+		callStack[i++] = 0;
+	}
+#endif
+}
+
+/*
+==================
+Sys_GetCallStackStr
+==================
+*/
+const char *Sys_GetCallStackStr( const address_t *callStack, const int callStackSize ) {
+	static __declspec( thread ) char string[MAX_STRING_CHARS*8];	// per thread: two threads must not share the result buffer
+	int index, i, n;
+	idStr module, funcName;
+
+	index = 0;
+	for ( i = callStackSize-1; i >= 0; i-- ) {
+		if ( callStack[i] == 0 ) {
+			continue;
+		}
+#if defined(_M_X64)
+		// a return address points after the call, back up one byte to land inside the caller
+		Sym_GetFuncInfo( callStack[i] - 1, module, funcName );
+#else
+		Sym_GetFuncInfo( callStack[i], module, funcName );
+#endif
+		n = idStr::snPrintf( string+index, sizeof( string ) - index - 1, " -> %s", funcName.c_str() );
+		if ( n < 0 ) {
+			index = sizeof( string ) - 1;
+			break;
+		}
+		index += n;
+	}
+	string[index] = '\0';
+	return string;
+}
+
+/*
+==================
+Sys_GetCallStackCurStr
+==================
+*/
+const char *Sys_GetCallStackCurStr( int depth ) {
+	address_t *callStack;
+
+	callStack = (address_t *) _alloca( depth * sizeof( address_t ) );
+	Sys_GetCallStack( callStack, depth );
+	return Sys_GetCallStackStr( callStack, depth );
+}
+
+/*
+==================
+Sys_GetCallStackCurAddressStr
+==================
+*/
+const char *Sys_GetCallStackCurAddressStr( int depth ) {
+	static __declspec( thread ) char string[MAX_STRING_CHARS*2];
+	address_t *callStack;
+	int index, i;
+
+	callStack = (address_t *) _alloca( depth * sizeof( address_t ) );
+	Sys_GetCallStack( callStack, depth );
+
+	index = 0;
+	for ( i = depth-1; i >= 0; i-- ) {
+		index += sprintf( string+index, " -> 0x%016llx", (unsigned long long)callStack[i] );	// x64: 64-bit address
+	}
+	string[index] = '\0';
+	return string;
+}
+
+/*
+==================
+Sys_ShutdownSymbols
+==================
+*/
+void Sys_ShutdownSymbols( void ) {
+	Sym_Shutdown();
+}
