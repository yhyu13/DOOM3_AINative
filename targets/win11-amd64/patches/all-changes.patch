+/*
+===============================================================================
+
+	Call stack
+
+===============================================================================
+*/
+
+
+#define PROLOGUE_SIGNATURE 0x00EC8B55
+
+#include <dbghelp.h>
+
+const int UNDECORATE_FLAGS =	UNDNAME_NO_MS_KEYWORDS |
+								UNDNAME_NO_ACCESS_SPECIFIERS |
+								UNDNAME_NO_FUNCTION_RETURNS |
+								UNDNAME_NO_ALLOCATION_MODEL |
+								UNDNAME_NO_ALLOCATION_LANGUAGE |
+								UNDNAME_NO_MEMBER_TYPE;
+
+#if defined(_M_X64)
+
+/*
+x64: symbolication through dbghelp (SymInitialize with invadeProcess loads every module, PDBs are
+found next to the executable or through the path recorded in the image). Stack capture lives in
+Sys_GetCallStack. dbghelp is single threaded, so lookups are serialised with a tiny spin lock.
+*/
+static bool			symInitDone = false;
+static bool			symAvailable = false;
+static volatile LONG symLock = 0;			// 0 = free, otherwise the owning thread id
+static volatile LONG symLockOwner = 0;
+
+/*
+Returns false when the calling thread already owns the lock (an Error raised while symbolising,
+or a crash inside dbghelp): the caller must then skip symbolisation and print raw addresses
+instead of spinning forever. Never call Sym_Unlock after a false return.
+*/
+static bool Sym_Lock( void ) {
+	const LONG self = (LONG)GetCurrentThreadId();
+	if ( symLockOwner == self ) {
+		return false;
+	}
+	while ( InterlockedCompareExchange( &symLock, 1, 0 ) != 0 ) {
+		SwitchToThread();
+	}
+	symLockOwner = self;
+	return true;
+}
+
+static void Sym_Unlock( void ) {
+	symLockOwner = 0;
+	InterlockedExchange( &symLock, 0 );
+}
+
+/*
+==================
+Sym_Init
+==================
+*/
+void Sym_Init( address_t addr ) {
+	if ( symInitDone ) {
+		return;
+	}
+	symInitDone = true;
+	SymSetOptions( SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES | SYMOPT_FAIL_CRITICAL_ERRORS | SYMOPT_NO_PROMPTS );
+	symAvailable = SymInitialize( GetCurrentProcess(), NULL, TRUE ) != FALSE;
+}
+
+/*
+==================
+Sym_Shutdown
+==================
+*/
+void Sym_Shutdown( void ) {
+	if ( !Sym_Lock() ) {
+		return;
+	}
+	if ( symAvailable ) {
+		SymCleanup( GetCurrentProcess() );
+	}
+	symAvailable = false;
+	symInitDone = false;
+	Sym_Unlock();
+}
+
+/*
+==================
+Sym_GetFuncInfo
+
+  module = short module name, funcName = "Function+0xdisp (file.cpp:line)" when the PDB is found,
+  otherwise "module+0xoffset" so an unresolved frame is still locatable.
+==================
+*/
+void Sym_GetFuncInfo( address_t addr, idStr &module, idStr &funcName ) {
+	HMODULE hMod = NULL;
+	char modPath[MAX_PATH];
+	char modShort[MAX_PATH];
+	DWORD64 modBase = 0;
+
+	module = "";
+	modPath[0] = '\0';
+	modShort[0] = '\0';
+	if ( GetModuleHandleExA( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)addr, &hMod ) && hMod ) {
+		modBase = (DWORD64)(ULONG_PTR)hMod;
+		if ( GetModuleFileNameA( hMod, modPath, sizeof( modPath ) ) ) {
+			_splitpath( modPath, NULL, NULL, modShort, NULL );
+			module = modShort;
+		}
+	}
+
+	const bool locked = Sym_Lock();
+	if ( locked ) {
+		Sym_Init( addr );
+	}
+	if ( locked && symAvailable ) {
+		BYTE symbolBuffer[ sizeof( SYMBOL_INFO ) + 512 ];
+		PSYMBOL_INFO pSym = (PSYMBOL_INFO)symbolBuffer;
+		DWORD64 disp = 0;
+
+		memset( symbolBuffer, 0, sizeof( symbolBuffer ) );
+		pSym->SizeOfStruct = sizeof( SYMBOL_INFO );
+		pSym->MaxNameLen = 511;
+		if ( SymFromAddr( GetCurrentProcess(), (DWORD64)addr, &disp, pSym ) ) {
+			IMAGEHLP_LINE64 line;
+			DWORD lineDisp = 0;
+
+			memset( &line, 0, sizeof( line ) );
+			line.SizeOfStruct = sizeof( line );
+			sprintf( funcName, "%s+0x%x", pSym->Name, (unsigned int)disp );
+			if ( SymGetLineFromAddr64( GetCurrentProcess(), (DWORD64)addr, &lineDisp, &line ) && line.FileName ) {
+				const char *file = strrchr( line.FileName, '\\' );
+				file = file ? file + 1 : line.FileName;
+				funcName += va( " (%s:%u)", file, (unsigned int)line.LineNumber );
+			}
+			Sym_Unlock();
+			return;
+		}
+	}
+	if ( locked ) {
+		Sym_Unlock();
+	}
+
+	if ( modBase ) {
+		sprintf( funcName, "%s+0x%llx", modShort, (unsigned long long)( (DWORD64)addr - modBase ) );
+	} else {
+		sprintf( funcName, "0x%016llx", (unsigned long long)addr );
+	}
+}
