* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf
*.png binary
*.jpg binary

# The generated deck is hashed byte-for-byte by verify_variants.py. Do not let
# core.autocrlf turn its LF into CRLF on checkout.
showcase/index.html text eol=lf

# Provenance hashes are byte hashes of the working file (shaders/tools/provenance-record.ps1).
# Without this, a Windows checkout rewrites LF to CRLF and all ten recorded hashes drift.
shaders/** text eol=lf

# Hero provenance records the generator and helper SHA-256 as byte hashes. Without LF pinning, a
# Windows checkout rewrites these scripts to CRLF and every recorded tool hash drifts.
content/tools/generators/*.py text eol=lf
*.pk4 binary
*.pk3 binary
*.wasm binary

# Patches against CRLF sources must keep their CRs byte-for-byte, or git apply fails
targets/*/patches/*.patch binary
targets/*/patches/*.manifest.txt -text

# The T056 measurement artifact is hashed byte-for-byte in evidence-q4.md and PR #75. Pin LF so a
# Windows checkout does not rewrite it and the recorded hash drifts.
specs/004-quality-renderer/evidence/t056/measurements.json text eol=lf
