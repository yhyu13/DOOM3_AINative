# ---- OS / editor ----
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# ---- Kilo / agent harness local state ----
.kilo/agent-manager.json
.kilo/worktrees/
# generated skill mirror: .claude/skills is the tracked source of truth, .kilo/skills is local
# (scripts/sync-skills.ps1 writes it; scripts/verify-skills.ps1 fails when the two differ)
.kilo/skills/
.kilocode/
.opencode/

# ---- per-target migration copies (untracked scratch trees; see targets/README.md) ----
targets/*/doom3/
targets/*/build/
targets/*/out/

# ---- build output (per worktree, never shared) ----
build/
build-*/
out/
bin/
obj/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.sln.docstates
*.suo
*.user
*.VC.db
*.VC.opendb
*.pdb
*.ilk
*.obj
*.o
*.a
*.lib
*.exp
*.exe
*.dll
*.so
*.dylib

# ---- web / wasm build output ----
web/dist/
web/build/
dist/
node_modules/
*.wasm
*.wasm.map
*.data
*.js.mem

# ---- game data: not redistributable with the source (see doom3_orig/doom3/README.txt) ----
*.pk4
*.pk3
*.pak
*.resources

# ---- local demo/run data (derived shims; never commit) ----
_data/
**/base/guis/mainmenu.gui
**/base/script/weapon_base.script

# ---- logs / temp ----
*.log
logs/
tmp/
*.tmp
.cache/
