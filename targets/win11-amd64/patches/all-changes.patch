diff --git a/a/neo/d3xp/GameEdit.cpp b/b/neo/d3xp/GameEdit.cpp
index 1ec1c14..e56ab21 100644
--- a/a/neo/d3xp/GameEdit.cpp
+++ b/b/neo/d3xp/GameEdit.cpp
@@ -767,14 +767,14 @@ const char *idGameEdit::GetUniqueEntityName( const char *classname ) const {
 
 	// can only have MAX_GENTITIES, so if we have a spot available, we're guaranteed to find one
 	for( id = 0; id < MAX_GENTITIES; id++ ) {
-		idStr::snPrintf( name, sizeof( name ), "%s_%d", classname, id );
+		idStr::snPrintf( name, (int)sizeof( name ), "%s_%d", classname, id );	/* x64: size_t -> int size */
 		if ( !gameLocal.FindEntity( name ) ) {
 			return name;
 		}
 	}
 
 	// id == MAX_GENTITIES + 1, which can't be in use if we get here
-	idStr::snPrintf( name, sizeof( name ), "%s_%d", classname, id );
+	idStr::snPrintf( name, (int)sizeof( name ), "%s_%d", classname, id );	/* x64: size_t -> int size */
 	return name;
 }
 
