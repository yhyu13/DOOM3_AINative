+int Sys_GetDriveFreeSpace( const char *path ) {
+	DWORDLONG lpFreeBytesAvailable;
+	DWORDLONG lpTotalNumberOfBytes;
+	DWORDLONG lpTotalNumberOfFreeBytes;
