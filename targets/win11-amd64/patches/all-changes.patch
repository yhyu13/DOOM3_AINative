-/*
-================
-Has3DNow
-================
-*/
-static bool Has3DNow( void ) {
-	unsigned regs[4];
-
-	// check AMD-specific functions
-	CPUID( 0x80000000, regs );
-	if ( regs[_REG_EAX] < 0x80000000 ) {
-		return false;
-	}
-
-	// bit 31 of EDX denotes 3DNow! support
-	CPUID( 0x80000001, regs );
-	if ( regs[_REG_EDX] & ( 1 << 31 ) ) {
-		return true;
-	}
-
-	return false;
-}
