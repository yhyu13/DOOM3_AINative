+/*
+================
+CPUCount
+
+	logicalNum is the number of logical CPU per physical CPU
+    physicalNum is the total number of physical processor
+	returns one of the HT_* flags
+================
+*/
+#define HT_NOT_CAPABLE				0
+#define HT_ENABLED					1
+#define HT_DISABLED					2
+#define HT_SUPPORTED_NOT_ENABLED	3
+#define HT_CANNOT_DETECT			4
+
+int CPUCount( int &logicalNum, int &physicalNum ) {
+	int statusFlag;
+	SYSTEM_INFO info;
+
+	physicalNum = 1;
+	logicalNum = 1;
+	statusFlag = HT_NOT_CAPABLE;
+
+	info.dwNumberOfProcessors = 0;
+	GetSystemInfo (&info);
+
+	// Number of physical processors in a non-Intel system
+	// or in a 32-bit Intel system with Hyper-Threading technology disabled
+	physicalNum = info.dwNumberOfProcessors;  
+
+	unsigned char HT_Enabled = 0;
+
+	logicalNum = LogicalProcPerPhysicalProc();
+
+	if ( logicalNum >= 1 ) {	// > 1 doesn't mean HT is enabled in the BIOS
+		HANDLE hCurrentProcessHandle;
+		DWORD_PTR dwProcessAffinity;		// x64: affinity masks are DWORD_PTR
+		DWORD_PTR dwSystemAffinity;
+		DWORD_PTR dwAffinityMask;
+
+		// Calculate the appropriate  shifts and mask based on the 
+		// number of logical processors.
+
+		unsigned char i = 1, PHY_ID_MASK  = 0xFF, PHY_ID_SHIFT = 0;
+
+		while( i < logicalNum ) {
+			i *= 2;
+ 			PHY_ID_MASK  <<= 1;
+			PHY_ID_SHIFT++;
+		}
+		
+		hCurrentProcessHandle = GetCurrentProcess();
+		GetProcessAffinityMask( hCurrentProcessHandle, &dwProcessAffinity, &dwSystemAffinity );
+
+		// Check if available process affinity mask is equal to the
+		// available system affinity mask
+		if ( dwProcessAffinity != dwSystemAffinity ) {
+			statusFlag = HT_CANNOT_DETECT;
+			physicalNum = -1;
+			return statusFlag;
+		}
+
+		dwAffinityMask = 1;
+		while ( dwAffinityMask != 0 && dwAffinityMask <= dwProcessAffinity ) {
+			// Check if this CPU is available
+			if ( dwAffinityMask & dwProcessAffinity ) {
+				if ( SetProcessAffinityMask( hCurrentProcessHandle, dwAffinityMask ) ) {
+					unsigned char APIC_ID, LOG_ID, PHY_ID;
+
+					Sleep( 0 ); // Give OS time to switch CPU
+
+					APIC_ID = GetAPIC_ID();
+					LOG_ID  = APIC_ID & ~PHY_ID_MASK;
+					PHY_ID  = APIC_ID >> PHY_ID_SHIFT;
+
+					if ( LOG_ID != 0 ) {
+						HT_Enabled = 1;
+					}
+				}
+			}
+			dwAffinityMask = dwAffinityMask << 1;
+		}
+	        
+		// Reset the processor affinity
+		SetProcessAffinityMask( hCurrentProcessHandle, dwProcessAffinity );
+	    
+		if ( logicalNum == 1 ) {  // Normal P4 : HT is disabled in hardware
+			statusFlag = HT_DISABLED;
+		} else {
+			if ( HT_Enabled ) {
+				// Total physical processors in a Hyper-Threading enabled system.
+				physicalNum /= logicalNum;
+				statusFlag = HT_ENABLED;
+			} else {
+				statusFlag = HT_SUPPORTED_NOT_ENABLED;
+			}
+		}
+	}
+	return statusFlag;
+}
+
+/*
+================
+HasHTT
+================
+*/
+static bool HasHTT( void ) {
+	unsigned regs[4];
+	int logicalNum, physicalNum, HTStatusFlag;
+
+	// get CPU feature bits
+	CPUID( 1, regs );
+
+	// bit 28 of EDX denotes HTT existence
+	if ( !( regs[_REG_EDX] & ( 1 << 28 ) ) ) {
+		return false;
+	}
+
+	HTStatusFlag = CPUCount( logicalNum, physicalNum );
+	if ( HTStatusFlag != HT_ENABLED ) {
+		return false;
+	}
+	return true;
+}
+
+/*
+================
+HasHTT
+================
+*/
+static bool HasDAZ( void ) {
+#if defined(_M_X64)
+
+	// x64: probe MXCSR bit 6 through intrinsics instead of FXSAVE
+	unsigned int csr = _mm_getcsr();
+	_mm_setcsr( csr | ( 1 << 6 ) );
+	unsigned int newCsr = _mm_getcsr();
+	_mm_setcsr( csr );
+	return ( newCsr & ( 1 << 6 ) ) != 0;
+
+#else
+	__declspec(align(16)) unsigned char FXSaveArea[512];
+	unsigned char *FXArea = FXSaveArea;
+	DWORD dwMask = 0;
+	unsigned regs[4];
+
+	// get CPU feature bits
+	CPUID( 1, regs );
+
+	// bit 24 of EDX denotes support for FXSAVE
+	if ( !( regs[_REG_EDX] & ( 1 << 24 ) ) ) {
+		return false;
+	}
+
+	memset( FXArea, 0, sizeof( FXSaveArea ) );
+
+	__asm {
+		mov		eax, FXArea
+		FXSAVE	[eax]
+	}
+
+	dwMask = *(DWORD *)&FXArea[28];						// Read the MXCSR Mask
+	return ( ( dwMask & ( 1 << 6 ) ) == ( 1 << 6 ) );	// Return if the DAZ bit is set
+#endif
+}
+
+#if defined(_M_X64)
+/*
+================
+Sys_GetCPUInfoString
+
+  x64: vendor id, brand string and raw CPUID leaf 1 / 7 feature words, for the sys_cpuInfo command
+================
+*/
+const char *Sys_GetCPUInfoString( void ) {
+	static char info[1024];
+	int regs[4], maxLeaf, i;
+	char vendor[13], brand[49];
+
+	__cpuid( regs, 0 );
+	maxLeaf = regs[0];
+	memcpy( vendor + 0, &regs[1], 4 );
+	memcpy( vendor + 4, &regs[3], 4 );
+	memcpy( vendor + 8, &regs[2], 4 );
+	vendor[12] = 0;
+
+	memset( brand, 0, sizeof( brand ) );
+	__cpuid( regs, (int)0x80000000 );
+	if ( (unsigned)regs[0] >= 0x80000004u ) {
+		for ( i = 0; i < 3; i++ ) {
+			__cpuid( regs, (int)0x80000002 + i );
+			memcpy( brand + i * 16, regs, 16 );
+		}
+	}
+
+	__cpuid( regs, 1 );
+	int leaf1[4] = { regs[0], regs[1], regs[2], regs[3] };
+	int leaf7[4] = { 0, 0, 0, 0 };
+	if ( maxLeaf >= 7 ) {
+		__cpuidex( leaf7, 7, 0 );
+	}
+	// AVX/AVX2 are usable only when the OS saves YMM state: OSXSAVE (leaf1 ecx bit 27) and
+	// XCR0 bits 1 (SSE) and 2 (YMM) set. The raw CPUID bits alone are not enough.
+	int osYmm = 0;
+	if ( ( leaf1[2] >> 27 ) & 1 ) {
+		osYmm = ( ( _xgetbv( 0 ) & 6 ) == 6 ) ? 1 : 0;
+	}
+	int avx = osYmm && ( ( leaf1[2] >> 28 ) & 1 );
+	int avx2 = osYmm && ( ( leaf7[1] >> 5 ) & 1 );
+	// "HTT flag" is CPUID leaf1 EDX bit 28; "addressable logical IDs" is EBX[23:16]. Both only say the
+	// package can hold several logical processors and are set on many CPUs without Hyper-Threading
+	// (e.g. multi-core parts), so neither is a count of actual hardware threads.
+	sprintf( info, "CPU vendor = %s, brand = %s, family %d model %d stepping %d, HTT flag (CPUID bit 28) = %d, "
+				"addressable logical IDs per package (EBX[23:16], not an HT proof) = %d, "
+				"leaf1 ecx=%08x edx=%08x, leaf7 ebx=%08x, SSE4.2=%d AVX=%d AVX2=%d (OS YMM state %s)\n",
+				vendor, brand, ( leaf1[0] >> 8 ) & 15, ( leaf1[0] >> 4 ) & 15, leaf1[0] & 15, ( leaf1[3] >> 28 ) & 1, ( leaf1[1] >> 16 ) & 255,
+				leaf1[2], leaf1[3], leaf7[1], ( leaf1[2] >> 20 ) & 1, avx, avx2, osYmm ? "enabled" : "not enabled" );
+	return info;
+}
+#endif
+
+/*
+================
+Sys_GetCPUId
+================
+*/
+cpuid_t Sys_GetCPUId( void ) {
+	int flags;
+
+	// verify we're at least a Pentium or 486 with CPUID support
+	if ( !HasCPUID() ) {
+		return CPUID_UNSUPPORTED;
+	}
+
+	// check for an AMD
+	if ( IsAMD() ) {
+		flags = CPUID_AMD;
+	} else {
+		flags = CPUID_INTEL;
+	}
+
+	// check for Multi Media Extensions
+	if ( HasMMX() ) {
+		flags |= CPUID_MMX;
+	}
+
+	// check for 3DNow!
+	if ( Has3DNow() ) {
+		flags |= CPUID_3DNOW;
+	}
+
+	// check for Streaming SIMD Extensions
+	if ( HasSSE() ) {
+		flags |= CPUID_SSE | CPUID_FTZ;
+	}
+
+	// check for Streaming SIMD Extensions 2
+	if ( HasSSE2() ) {
+		flags |= CPUID_SSE2;
+	}
+
+	// check for Streaming SIMD Extensions 3 aka Prescott's New Instructions
+	if ( HasSSE3() ) {
+		flags |= CPUID_SSE3;
+	}
+
+	// check for Hyper-Threading Technology
+	if ( HasHTT() ) {
+		flags |= CPUID_HTT;
+	}
+
+	// check for Conditional Move (CMOV) and fast floating point comparison (FCOMI) instructions
+	if ( HasCMOV() ) {
+		flags |= CPUID_CMOV;
+	}
+
+	// check for Denormals-Are-Zero mode
+	if ( HasDAZ() ) {
+		flags |= CPUID_DAZ;
+	}
+
+	return (cpuid_t)flags;
+}
