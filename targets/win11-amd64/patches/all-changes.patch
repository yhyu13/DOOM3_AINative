+/*
+================
+Sys_GetVideoRam
+returns in megabytes
+================
+*/
+int Sys_GetVideoRam( void ) {
+#ifdef	ID_DEDICATED
+	return 0;
+#else
+	unsigned int retSize = 64;
+
+	// x64: ATL CComPtr/CComBSTR are not guaranteed with the MFC-free build; use raw COM
+	IWbemLocator *pLoc = NULL;
+	IWbemServices *pServices = NULL;
+	IEnumWbemClassObject *pEnumInst = NULL;
+	IWbemClassObject *pInstance = NULL;
+	BSTR bstr;
+
+	HRESULT hr = CoCreateInstance( CLSID_WbemLocator, 0, CLSCTX_SERVER, IID_IWbemLocator, ( LPVOID * ) &pLoc );
+	if ( hr != S_OK || pLoc == NULL ) {
+		return retSize;
+	}
+
+	// Connect to CIM
+	bstr = SysAllocString( L"\\\\.\\root\\CIMV2" );
+	hr = pLoc->ConnectServer( bstr, NULL, NULL, 0, NULL, 0, 0, &pServices );
+	SysFreeString( bstr );
+	if ( hr != WBEM_S_NO_ERROR ) {
+		pLoc->Release();
+		return retSize;
+	}
+
+	// Switch the security level to IMPERSONATE so that provider will grant access to system-level objects.  
+	hr = CoSetProxyBlanket( pServices, RPC_C_AUTHN_WINNT, RPC_C_AUTHZ_NONE, NULL, RPC_C_AUTHN_LEVEL_CALL, RPC_C_IMP_LEVEL_IMPERSONATE, NULL, EOAC_NONE );
+	if ( hr != S_OK ) {
+		pServices->Release();
+		pLoc->Release();
+		return retSize;
+	}
+
+	// Get the vid controller
+	bstr = SysAllocString( L"Win32_VideoController" );
+	hr = pServices->CreateInstanceEnum( bstr, WBEM_FLAG_SHALLOW, NULL, &pEnumInst );
+	SysFreeString( bstr );
+	if ( hr != WBEM_S_NO_ERROR || pEnumInst == NULL ) {
+		pServices->Release();
+		pLoc->Release();
+		return retSize;
+	}
+
+	ULONG uNumOfInstances = 0;
+	hr = pEnumInst->Next( 10000, 1, &pInstance, &uNumOfInstances );
+
+	if ( hr == S_OK && pInstance ) {
+		// Get properties from the object
+		VARIANT varSize;
+		VariantInit( &varSize );
+		bstr = SysAllocString( L"AdapterRAM" );
+		hr = pInstance->Get( bstr, 0, &varSize, 0, 0 );
+		SysFreeString( bstr );
+		if ( hr == S_OK ) {
+			retSize = (int)( varSize.ulVal / ( 1024 * 1024 ) );	/* x64 review: AdapterRAM is VT_UI4; intVal went negative for >= 2 GB */
+			if ( retSize == 0 ) {
+				retSize = 64;
+			}
+		}
+		VariantClear( &varSize );
+		pInstance->Release();
+	}
+
+	pEnumInst->Release();
+	pServices->Release();
+	pLoc->Release();
+	return retSize;
+#endif
+}
