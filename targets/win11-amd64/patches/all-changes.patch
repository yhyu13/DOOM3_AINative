+Sys_Milliseconds
+================
+*/
+int Sys_Milliseconds( void ) {
+	int sys_curtime;
+	static int sys_timeBase;
+	static bool	initialized = false;
+
+	if ( !initialized ) {
+		sys_timeBase = timeGetTime();
+		initialized = true;
+	}
+	sys_curtime = timeGetTime() - sys_timeBase;
+
+	return sys_curtime;
+}
